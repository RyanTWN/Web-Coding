# 複製為 .env 後填入 NAS 的實際值；不要提交 .env。
DB_HOST=192.168.173.200
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-me
DB_NAME=cool_learning

# 至少 32 個隨機字元；修改後所有使用者需重新登入。
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 以逗號分隔正式前端網址；設定為 * 代表允許所有來源。
CORS_ORIGINS=https://learning.ifit.myds.me,http://localhost:5500

# 對外連接埠
WEB_PORT=8080
API_PORT=4060

# latest 會自動取得最新映像；也可指定 sha-<完整提交雜湊> 固定版本。
IMAGE_TAG=latest

# 正式網址目前使用 Synology Web Station 的 /cool_learning/ 路徑。
WEB_STATION_PATH=/volume1/web/cool_learning
