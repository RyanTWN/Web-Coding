# 複製為 .env 後填入 NAS 的實際值；不要提交 .env。
# DB_USER 請勿使用 root：先執行 ops/provision-app-db-user.sql 建立最小權限的
# 專用帳號（只有 cool_learning 這個資料庫的 CRUD + 建表權限，沒有任何全域權限），
# 再把該帳號的帳密填在這裡。
DB_HOST=192.168.173.200
DB_PORT=3306
DB_USER=cool_learning_app
DB_PASSWORD=replace-me
DB_NAME=cool_learning

# 至少 32 個隨機字元；修改後所有使用者需重新登入。
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 以逗號分隔正式前端網址；設定為 * 代表允許所有來源。
CORS_ORIGINS=https://learning.ifit.myds.me,http://localhost:5500

# B2C 家長帳號：Sign in with Apple / Google 登入驗證用。
# 要先申請 Apple Developer / Google Play Console 帳號、設定好 Sign in with Apple 與
# OAuth 用戶端後才會拿到這兩個值；在那之前對應的登入方式會直接回傳明確的設定錯誤。
APPLE_CLIENT_ID=replace-with-apple-services-id-or-bundle-id
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Google Play 訂閱驗證（優先做這個，Apple 之後再說）：
# 1. Google Play Console → 設定 → API 存取 → 連結一個 Google Cloud 專案，
#    在該專案建立一個服務帳號，並在 Play Console 把這個服務帳號加為「使用者」，
#    給予「查看財務資料」「管理訂單」等權限，下載該服務帳號的 JSON 金鑰。
GOOGLE_PLAY_PACKAGE_NAME=replace-with-app-package-name
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
# 2. Google Cloud Console → Pub/Sub → 建立一個 Topic，在 Play Console 的
#    「監控與即時通知」設定這個 Topic，接著在 Pub/Sub 建立一個 push 訂閱，
#    Endpoint URL 填你這支後端的 https://<你的網域>/api/webhooks/google-subscription，
#    並開啟「啟用驗證」（Enable authentication），指定一個服務帳號用來簽發 OIDC token。
GOOGLE_PUBSUB_AUDIENCE=https://learning.ifit.myds.me:4061/api/webhooks/google-subscription
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=replace-with-pubsub-push-service-account-email

# 對外連接埠
WEB_PORT=8080
API_PORT=4060

# latest 會自動取得最新映像；也可指定 sha-<完整提交雜湊> 固定版本。
IMAGE_TAG=latest

# 正式網址目前使用 Synology Web Station 的 /cool_learning/ 路徑。
WEB_STATION_PATH=/volume1/web/cool_learning
